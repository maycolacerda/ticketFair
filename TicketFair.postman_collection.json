            {
              "name": "List All Users — Client Token (forbidden)",
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Returns 403', () => pm.response.to.have.status(403));"] }}],
              "request": { "method": "GET", "url": "{{base_url}}/admin/users",
                "header": [{ "key": "Authorization", "value": "Bearer {{client_token}}" }] }
            },
            {
              "name": "Create User",
              "event": [{ "listen": "test", "script": { "exec": [
                "if (pm.response.code === 201) {",
