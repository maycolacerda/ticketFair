              "name": "Activate User",
              "event": [{ "listen": "test", "script": { "exec": [
                "pm.test('Returns 200', () => pm.response.to.have.status(200));",
                "pm.test('Has message', () => pm.expect(pm.response.json().message).to.include('activated'));"
              ]}}],
              "request": { "method": "POST", "url": "{{base_url}}/admin/users/{{admin_user_id}}/activate",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }] }
            }
