                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }] }
            },
            {
              "name": "Reactivate Seeded Merchant",
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Returns 200', () => pm.response.to.have.status(200));"] }}],
              "request": { "method": "POST", "url": "{{base_url}}/admin/merchants/a1b2c3d4-e5f6-7890-abcd-ef1234567890/activate",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }] }
            }
