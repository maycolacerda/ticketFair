  "item": [
    {
      "name": "🔑 Admin",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Admin Login",
              "event": [{ "listen": "test", "script": { "exec": [
                "if (pm.response.code === 200) {",
                "  pm.collectionVariables.set('admin_token', pm.response.json().data.token);",
                "  pm.test('Login successful', () => pm.response.to.have.status(200));",
                "  pm.test('Has token', () => pm.expect(pm.response.json().data.token).to.not.be.empty);",
                "  pm.test('Admin ID matches seed', () => pm.expect(pm.response.json().data.admin.admin_id).to.equal('d4e5f6a7-b8c9-0123-defa-234567890123'));",
                "  pm.test('Password not exposed', () => pm.expect(pm.response.json().data.admin).to.not.have.property('password'));",
                "}"
              ]}}],
              "request": { "method": "POST", "url": "{{base_url}}/admin/auth/login",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@ticketfair.com\",\n  \"password\": \"PassW0rd!\"\n}" }}
            },
            {
              "name": "Admin Login — Wrong Password",
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Returns 401', () => pm.response.to.have.status(401));"] }}],
              "request": { "method": "POST", "url": "{{base_url}}/admin/auth/login",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@ticketfair.com\",\n  \"password\": \"Wrong!\"\n}" }}
            }
          ]
        },
        {
          "name": "Users",
          "item": [
            {
              "name": "List All Users",
              "event": [{ "listen": "test", "script": { "exec": [
                "pm.test('Returns 200', () => pm.response.to.have.status(200));",
                "pm.test('Has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
              ]}}],
              "request": { "method": "GET", "url": "{{base_url}}/admin/users?page=1&limit=20",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }] }
